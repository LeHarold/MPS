const CACHE='map-workspace-v128',FILES=['device-transfer.mjs?v=128','print-raster.mjs?v=128','./','index.html','workspace.css?v=128','workspace.js?v=128','point-relations.mjs?v=128','label-visibility.mjs?v=128','workspace-model.mjs?v=128','waypoint-picker.mjs?v=128','instrument-lock.mjs?v=128','elevation-store.mjs?v=128','map-inputs.mjs?v=128','coordinates.mjs','authorization.mjs?v=128','licensed-tools.mjs?v=128','license-public-key.json?v=128','project-merge.mjs?v=128','project-merge-worker.mjs?v=128','workspace-ux.mjs?v=128','workspace-interactions.mjs?v=128','manifest.webmanifest?v=128','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','MPS-Offline.exe','world.json?v=128','routes.json?v=128','references.json?v=128','navaids.json?v=128','data-sources.html','airports.json?v=128'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(caches.keys().then(keys=>Promise.all(keys.filter(key=>/^(map-workspace-|asia-atlas-)/.test(key)&&key!==CACHE).map(key=>caches.delete(key)))).then(()=>self.clients.claim())));
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;if(request.mode==='navigate'){event.respondWith(fetch(request).then(response=>{if(!response.ok)throw Error('navigation unavailable');return response}).catch(async()=>await caches.match(request)||await caches.match('index.html')));return}event.respondWith(caches.match(request).then(cached=>cached||fetch(request)))});

