const CACHE='map-workspace-v123',FILES=['print-raster.mjs?v=123','./','index.html','workspace.css?v=123','workspace.js?v=123','point-relations.mjs?v=123','label-visibility.mjs?v=123','workspace-model.mjs?v=123','waypoint-picker.mjs?v=123','instrument-lock.mjs?v=123','elevation-store.mjs?v=123','map-inputs.mjs?v=123','coordinates.mjs','authorization.mjs?v=123','licensed-tools.mjs?v=123','license-public-key.json?v=123','project-merge.mjs?v=123','project-merge-worker.mjs?v=123','workspace-ux.mjs?v=123','workspace-interactions.mjs?v=123','manifest.webmanifest?v=123','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','MPS-Offline.exe','world.json?v=123','routes.json?v=123','references.json?v=123','navaids.json?v=123','data-sources.html','airports.json?v=123'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(caches.keys().then(keys=>Promise.all(keys.filter(key=>/^(map-workspace-|asia-atlas-)/.test(key)&&key!==CACHE).map(key=>caches.delete(key)))).then(()=>self.clients.claim())));
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;if(request.mode==='navigate'){event.respondWith(fetch(request).then(response=>{if(!response.ok)throw Error('navigation unavailable');return response}).catch(async()=>await caches.match(request)||await caches.match('index.html')));return}event.respondWith(caches.match(request).then(cached=>cached||fetch(request)))});

