const CACHE='map-workspace-v180',FILES=['live-vehicles.mjs?v=180','spatial-objects.mjs?v=180','compact-waypoints.mjs?v=180','coordinate-excel.mjs?v=180','line-appearance.mjs?v=180','navigation-ruler.mjs?v=180','navigation-ruler.css?v=180','vendor/wmm2025.mjs','vendor/wmm2025.LICENSE','workspace-storage.mjs?v=180','display-performance.mjs?v=180','area-labels.mjs?v=180','label-stability.mjs?v=180','history-timeline.mjs?v=180','movement.mjs?v=180','label-rotation.mjs?v=180','point-snap.mjs?v=180','ios-pwa.mjs?v=180','action-history.mjs?v=180','license-transfer.mjs?v=180','device-transfer.mjs?v=180','print-raster.mjs?v=180','./','index.html','workspace.css?v=180','workspace.js?v=180','point-relations.mjs?v=180','label-visibility.mjs?v=180','map-editing.mjs?v=180','press-controls.mjs?v=180','workspace-model.mjs?v=180','waypoint-picker.mjs?v=180','instrument-lock.mjs?v=180','elevation-store.mjs?v=180','map-inputs.mjs?v=180','coordinates.mjs','authorization.mjs?v=180','licensed-tools.mjs?v=180','license-public-key.json?v=180','project-merge.mjs?v=180','project-merge-worker.mjs?v=180','workspace-ux.mjs?v=180','workspace-interactions.mjs?v=180','manifest.webmanifest?v=180','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=180','routes.json?v=180','references.json?v=180','navaids.json?v=180','data-sources.html','airports.json?v=180'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await caches.match(request);if(cached)return cached;try{const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response}catch(error){const fallback=await cache.match(request,{ignoreSearch:true});if(fallback)return fallback;throw error}})())});
