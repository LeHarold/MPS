const CACHE='map-workspace-v188',FILES=['live-vehicles.mjs?v=188','spatial-objects.mjs?v=188','compact-waypoints.mjs?v=188','coordinate-excel.mjs?v=188','line-appearance.mjs?v=188','navigation-ruler.mjs?v=188','navigation-ruler.css?v=188','vendor/wmm2025.mjs','vendor/wmm2025.LICENSE','workspace-storage.mjs?v=188','display-performance.mjs?v=188','area-labels.mjs?v=188','label-stability.mjs?v=188','history-timeline.mjs?v=188','movement.mjs?v=188','label-rotation.mjs?v=188','point-snap.mjs?v=188','ios-pwa.mjs?v=188','action-history.mjs?v=188','license-transfer.mjs?v=188','device-transfer.mjs?v=188','print-raster.mjs?v=188','./','index.html','workspace.css?v=188','workspace.js?v=188','point-relations.mjs?v=188','label-visibility.mjs?v=188','map-editing.mjs?v=188','press-controls.mjs?v=188','workspace-model.mjs?v=188','waypoint-picker.mjs?v=188','instrument-lock.mjs?v=188','elevation-store.mjs?v=188','map-inputs.mjs?v=188','coordinates.mjs','authorization.mjs?v=188','licensed-tools.mjs?v=188','license-public-key.json?v=188','project-merge.mjs?v=188','project-merge-worker.mjs?v=188','workspace-ux.mjs?v=188','workspace-interactions.mjs?v=188','manifest.webmanifest?v=188','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=188','routes.json?v=188','references.json?v=188','navaids.json?v=188','data-sources.html','airports.json?v=188'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await caches.match(request);if(cached)return cached;try{const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response}catch(error){const fallback=await cache.match(request,{ignoreSearch:true});if(fallback)return fallback;throw error}})())});
