const CACHE='map-workspace-v179',FILES=['live-vehicles.mjs?v=179','spatial-objects.mjs?v=179','compact-waypoints.mjs?v=179','coordinate-excel.mjs?v=179','line-appearance.mjs?v=179','navigation-ruler.mjs?v=179','navigation-ruler.css?v=179','vendor/wmm2025.mjs','vendor/wmm2025.LICENSE','workspace-storage.mjs?v=179','display-performance.mjs?v=179','area-labels.mjs?v=179','label-stability.mjs?v=179','history-timeline.mjs?v=179','movement.mjs?v=179','label-rotation.mjs?v=179','point-snap.mjs?v=179','ios-pwa.mjs?v=179','action-history.mjs?v=179','license-transfer.mjs?v=179','device-transfer.mjs?v=179','print-raster.mjs?v=179','./','index.html','workspace.css?v=179','workspace.js?v=179','point-relations.mjs?v=179','label-visibility.mjs?v=179','map-editing.mjs?v=179','press-controls.mjs?v=179','workspace-model.mjs?v=179','waypoint-picker.mjs?v=179','instrument-lock.mjs?v=179','elevation-store.mjs?v=179','map-inputs.mjs?v=179','coordinates.mjs','authorization.mjs?v=179','licensed-tools.mjs?v=179','license-public-key.json?v=179','project-merge.mjs?v=179','project-merge-worker.mjs?v=179','workspace-ux.mjs?v=179','workspace-interactions.mjs?v=179','manifest.webmanifest?v=179','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=179','routes.json?v=179','references.json?v=179','navaids.json?v=179','data-sources.html','airports.json?v=179'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await caches.match(request);if(cached)return cached;try{const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response}catch(error){const fallback=await cache.match(request,{ignoreSearch:true});if(fallback)return fallback;throw error}})())});
