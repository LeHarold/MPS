const CACHE='map-workspace-v182',FILES=['live-vehicles.mjs?v=182','spatial-objects.mjs?v=182','compact-waypoints.mjs?v=182','coordinate-excel.mjs?v=182','line-appearance.mjs?v=182','navigation-ruler.mjs?v=182','navigation-ruler.css?v=182','vendor/wmm2025.mjs','vendor/wmm2025.LICENSE','workspace-storage.mjs?v=182','display-performance.mjs?v=182','area-labels.mjs?v=182','label-stability.mjs?v=182','history-timeline.mjs?v=182','movement.mjs?v=182','label-rotation.mjs?v=182','point-snap.mjs?v=182','ios-pwa.mjs?v=182','action-history.mjs?v=182','license-transfer.mjs?v=182','device-transfer.mjs?v=182','print-raster.mjs?v=182','./','index.html','workspace.css?v=182','workspace.js?v=182','point-relations.mjs?v=182','label-visibility.mjs?v=182','map-editing.mjs?v=182','press-controls.mjs?v=182','workspace-model.mjs?v=182','waypoint-picker.mjs?v=182','instrument-lock.mjs?v=182','elevation-store.mjs?v=182','map-inputs.mjs?v=182','coordinates.mjs','authorization.mjs?v=182','licensed-tools.mjs?v=182','license-public-key.json?v=182','project-merge.mjs?v=182','project-merge-worker.mjs?v=182','workspace-ux.mjs?v=182','workspace-interactions.mjs?v=182','manifest.webmanifest?v=182','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=182','routes.json?v=182','references.json?v=182','navaids.json?v=182','data-sources.html','airports.json?v=182'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await caches.match(request);if(cached)return cached;try{const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response}catch(error){const fallback=await cache.match(request,{ignoreSearch:true});if(fallback)return fallback;throw error}})())});
