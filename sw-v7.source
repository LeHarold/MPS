const CACHE='map-workspace-v131',FILES=['action-history.mjs?v=131','license-transfer.mjs?v=131','device-transfer.mjs?v=131','print-raster.mjs?v=131','./','index.html','workspace.css?v=131','workspace.js?v=131','point-relations.mjs?v=131','label-visibility.mjs?v=131','workspace-model.mjs?v=131','waypoint-picker.mjs?v=131','instrument-lock.mjs?v=131','elevation-store.mjs?v=131','map-inputs.mjs?v=131','coordinates.mjs','authorization.mjs?v=131','licensed-tools.mjs?v=131','license-public-key.json?v=131','project-merge.mjs?v=131','project-merge-worker.mjs?v=131','workspace-ux.mjs?v=131','workspace-interactions.mjs?v=131','manifest.webmanifest?v=131','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','MPS-Offline.exe','world.json?v=131','routes.json?v=131','references.json?v=131','navaids.json?v=131','data-sources.html','airports.json?v=131'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(caches.keys().then(keys=>Promise.all(keys.filter(key=>/^(map-workspace-|asia-atlas-)/.test(key)&&key!==CACHE).map(key=>caches.delete(key)))).then(()=>self.clients.claim())));
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;if(request.mode==='navigate'){event.respondWith(fetch(request).then(response=>{if(!response.ok)throw Error('navigation unavailable');return response}).catch(async()=>await caches.match(request)||await caches.match('index.html')));return}event.respondWith(caches.match(request).then(cached=>cached||fetch(request)))});

