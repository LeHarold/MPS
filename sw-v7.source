const CACHE='map-workspace-v183',FILES=['live-vehicles.mjs?v=183','spatial-objects.mjs?v=183','compact-waypoints.mjs?v=183','coordinate-excel.mjs?v=183','line-appearance.mjs?v=183','navigation-ruler.mjs?v=183','navigation-ruler.css?v=183','vendor/wmm2025.mjs','vendor/wmm2025.LICENSE','workspace-storage.mjs?v=183','display-performance.mjs?v=183','area-labels.mjs?v=183','label-stability.mjs?v=183','history-timeline.mjs?v=183','movement.mjs?v=183','label-rotation.mjs?v=183','point-snap.mjs?v=183','ios-pwa.mjs?v=183','action-history.mjs?v=183','license-transfer.mjs?v=183','device-transfer.mjs?v=183','print-raster.mjs?v=183','./','index.html','workspace.css?v=183','workspace.js?v=183','point-relations.mjs?v=183','label-visibility.mjs?v=183','map-editing.mjs?v=183','press-controls.mjs?v=183','workspace-model.mjs?v=183','waypoint-picker.mjs?v=183','instrument-lock.mjs?v=183','elevation-store.mjs?v=183','map-inputs.mjs?v=183','coordinates.mjs','authorization.mjs?v=183','licensed-tools.mjs?v=183','license-public-key.json?v=183','project-merge.mjs?v=183','project-merge-worker.mjs?v=183','workspace-ux.mjs?v=183','workspace-interactions.mjs?v=183','manifest.webmanifest?v=183','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=183','routes.json?v=183','references.json?v=183','navaids.json?v=183','data-sources.html','airports.json?v=183'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await caches.match(request);if(cached)return cached;try{const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response}catch(error){const fallback=await cache.match(request,{ignoreSearch:true});if(fallback)return fallback;throw error}})())});
