const CACHE='map-workspace-v168',FILES=['compact-waypoints.mjs?v=168','coordinate-excel.mjs?v=168','line-appearance.mjs?v=168','navigation-ruler.mjs?v=168','navigation-ruler.css?v=168','vendor/wmm2025.mjs','vendor/wmm2025.LICENSE','workspace-storage.mjs?v=168','display-performance.mjs?v=168','area-labels.mjs?v=168','label-stability.mjs?v=168','history-timeline.mjs?v=168','movement.mjs?v=168','label-rotation.mjs?v=168','point-snap.mjs?v=168','ios-pwa.mjs?v=168','action-history.mjs?v=168','license-transfer.mjs?v=168','device-transfer.mjs?v=168','print-raster.mjs?v=168','./','index.html','workspace.css?v=168','workspace.js?v=168','point-relations.mjs?v=168','label-visibility.mjs?v=168','map-editing.mjs?v=168','press-controls.mjs?v=168','workspace-model.mjs?v=168','waypoint-picker.mjs?v=168','instrument-lock.mjs?v=168','elevation-store.mjs?v=168','map-inputs.mjs?v=168','coordinates.mjs','authorization.mjs?v=168','licensed-tools.mjs?v=168','license-public-key.json?v=168','project-merge.mjs?v=168','project-merge-worker.mjs?v=168','workspace-ux.mjs?v=168','workspace-interactions.mjs?v=168','manifest.webmanifest?v=168','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=168','routes.json?v=168','references.json?v=168','navaids.json?v=168','data-sources.html','airports.json?v=168'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await caches.match(request);if(cached)return cached;try{const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response}catch(error){const fallback=await cache.match(request,{ignoreSearch:true});if(fallback)return fallback;throw error}})())});
