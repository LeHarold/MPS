const CACHE='map-workspace-v160',FILES=['navigation-ruler.mjs?v=160','navigation-ruler.css?v=160','vendor/wmm2025.mjs','vendor/wmm2025.LICENSE','workspace-storage.mjs?v=160','display-performance.mjs?v=160','area-labels.mjs?v=160','label-stability.mjs?v=160','history-timeline.mjs?v=160','movement.mjs?v=160','label-rotation.mjs?v=160','point-snap.mjs?v=160','ios-pwa.mjs?v=160','action-history.mjs?v=160','license-transfer.mjs?v=160','device-transfer.mjs?v=160','print-raster.mjs?v=160','./','index.html','workspace.css?v=160','workspace.js?v=160','point-relations.mjs?v=160','label-visibility.mjs?v=160','map-editing.mjs?v=160','press-controls.mjs?v=160','workspace-model.mjs?v=160','waypoint-picker.mjs?v=160','instrument-lock.mjs?v=160','elevation-store.mjs?v=160','map-inputs.mjs?v=160','coordinates.mjs','authorization.mjs?v=160','licensed-tools.mjs?v=160','license-public-key.json?v=160','project-merge.mjs?v=160','project-merge-worker.mjs?v=160','workspace-ux.mjs?v=160','workspace-interactions.mjs?v=160','manifest.webmanifest?v=160','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=160','routes.json?v=160','references.json?v=160','navaids.json?v=160','data-sources.html','airports.json?v=160'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await caches.match(request);if(cached)return cached;try{const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response}catch(error){const fallback=await cache.match(request,{ignoreSearch:true});if(fallback)return fallback;throw error}})())});
