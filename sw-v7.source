const CACHE='map-workspace-v177',FILES=['live-vehicles.mjs?v=177','spatial-objects.mjs?v=177','compact-waypoints.mjs?v=177','coordinate-excel.mjs?v=177','line-appearance.mjs?v=177','navigation-ruler.mjs?v=177','navigation-ruler.css?v=177','vendor/wmm2025.mjs','vendor/wmm2025.LICENSE','workspace-storage.mjs?v=177','display-performance.mjs?v=177','area-labels.mjs?v=177','label-stability.mjs?v=177','history-timeline.mjs?v=177','movement.mjs?v=177','label-rotation.mjs?v=177','point-snap.mjs?v=177','ios-pwa.mjs?v=177','action-history.mjs?v=177','license-transfer.mjs?v=177','device-transfer.mjs?v=177','print-raster.mjs?v=177','./','index.html','workspace.css?v=177','workspace.js?v=177','point-relations.mjs?v=177','label-visibility.mjs?v=177','map-editing.mjs?v=177','press-controls.mjs?v=177','workspace-model.mjs?v=177','waypoint-picker.mjs?v=177','instrument-lock.mjs?v=177','elevation-store.mjs?v=177','map-inputs.mjs?v=177','coordinates.mjs','authorization.mjs?v=177','licensed-tools.mjs?v=177','license-public-key.json?v=177','project-merge.mjs?v=177','project-merge-worker.mjs?v=177','workspace-ux.mjs?v=177','workspace-interactions.mjs?v=177','manifest.webmanifest?v=177','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=177','routes.json?v=177','references.json?v=177','navaids.json?v=177','data-sources.html','airports.json?v=177'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await caches.match(request);if(cached)return cached;try{const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response}catch(error){const fallback=await cache.match(request,{ignoreSearch:true});if(fallback)return fallback;throw error}})())});
