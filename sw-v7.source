const CACHE='map-workspace-v116',FILES=['./','index.html','workspace.css?v=116','workspace.js?v=116','point-relations.mjs?v=116','workspace-model.mjs?v=116','waypoint-picker.mjs?v=116','instrument-lock.mjs?v=116','elevation-store.mjs?v=116','map-inputs.mjs?v=116','coordinates.mjs','authorization.mjs?v=116','licensed-tools.mjs?v=116','license-public-key.json?v=116','project-merge.mjs?v=116','project-merge-worker.mjs?v=116','workspace-ux.mjs?v=116','workspace-interactions.mjs?v=116','manifest.webmanifest?v=116','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','MPS-Offline.exe','world.json?v=116','routes.json?v=116','references.json?v=116','navaids.json?v=116','data-sources.html','airports.json?v=116'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(caches.keys().then(keys=>Promise.all(keys.filter(key=>/^(map-workspace-|asia-atlas-)/.test(key)&&key!==CACHE).map(key=>caches.delete(key)))).then(()=>self.clients.claim())));
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;if(request.mode==='navigate'){event.respondWith(fetch(request).then(response=>{if(!response.ok)throw Error('navigation unavailable');return response}).catch(async()=>await caches.match(request)||await caches.match('index.html')));return}event.respondWith(caches.match(request).then(cached=>cached||fetch(request)))});

