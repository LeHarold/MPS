const CACHE='map-workspace-v141',FILES=['history-timeline.mjs?v=141','movement.mjs?v=141','label-rotation.mjs?v=141','point-snap.mjs?v=141','ios-pwa.mjs?v=141','action-history.mjs?v=141','license-transfer.mjs?v=141','device-transfer.mjs?v=141','print-raster.mjs?v=141','./','index.html','workspace.css?v=141','workspace.js?v=141','point-relations.mjs?v=141','label-visibility.mjs?v=141','map-editing.mjs?v=141','press-controls.mjs?v=141','workspace-model.mjs?v=141','waypoint-picker.mjs?v=141','instrument-lock.mjs?v=141','elevation-store.mjs?v=141','map-inputs.mjs?v=141','coordinates.mjs','authorization.mjs?v=141','licensed-tools.mjs?v=141','license-public-key.json?v=141','project-merge.mjs?v=141','project-merge-worker.mjs?v=141','workspace-ux.mjs?v=141','workspace-interactions.mjs?v=141','manifest.webmanifest?v=141','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=141','routes.json?v=141','references.json?v=141','navaids.json?v=141','data-sources.html','airports.json?v=141'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await caches.match(request);if(cached)return cached;try{const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response}catch(error){const fallback=await cache.match(request,{ignoreSearch:true});if(fallback)return fallback;throw error}})())});
