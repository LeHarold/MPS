const CACHE='map-workspace-v134',FILES=['ios-pwa.mjs?v=134','action-history.mjs?v=134','license-transfer.mjs?v=134','device-transfer.mjs?v=134','print-raster.mjs?v=134','./','index.html','workspace.css?v=134','workspace.js?v=134','point-relations.mjs?v=134','label-visibility.mjs?v=134','map-editing.mjs?v=134','press-controls.mjs?v=134','workspace-model.mjs?v=134','waypoint-picker.mjs?v=134','instrument-lock.mjs?v=134','elevation-store.mjs?v=134','map-inputs.mjs?v=134','coordinates.mjs','authorization.mjs?v=134','licensed-tools.mjs?v=134','license-public-key.json?v=134','project-merge.mjs?v=134','project-merge-worker.mjs?v=134','workspace-ux.mjs?v=134','workspace-interactions.mjs?v=134','manifest.webmanifest?v=134','icon.svg','icon-192.png','icon-512.png','vendor/leaflet.js','vendor/leaflet.css','vendor/html2canvas.min.js','vendor/jspdf.umd.min.js','vendor/jszip.min.js','offline-bootstrap.js','offline-files.json','world.json?v=134','routes.json?v=134','references.json?v=134','navaids.json?v=134','data-sources.html','airports.json?v=134'];
self.addEventListener('install',event=>event.waitUntil(caches.open(CACHE).then(cache=>cache.addAll(FILES)).then(()=>self.skipWaiting())));
self.addEventListener('activate',event=>event.waitUntil(self.clients.claim()));
self.addEventListener('message',event=>{if(event.data?.type==='MPS_CACHE_STATUS')event.ports?.[0]?.postMessage({cache:CACHE})});
self.addEventListener('fetch',event=>{const request=event.request,url=new URL(request.url);if(request.method!=='GET'||url.origin!==location.origin)return;event.respondWith((async()=>{const cache=await caches.open(CACHE);if(request.mode==='navigate'){const home=new URL(self.registration.scope),shell=url.pathname===home.pathname||url.pathname===new URL('index.html',home).pathname,key=shell?'index.html':request;try{const response=await fetch(request);if(!response.ok)throw Error('navigation unavailable');try{await cache.put(key,response.clone())}catch{}return response}catch{return await cache.match(key)||await caches.match(key)}}const cached=await cache.match(request)||await cache.match(request,{ignoreSearch:true})||await caches.match(request);if(cached)return cached;const response=await fetch(request);if(response.ok)try{await cache.put(request,response.clone())}catch{}return response})())});
